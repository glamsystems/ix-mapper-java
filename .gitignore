# Everything is ignored unless it is unblocked below, so a new top-level file or
# directory stays out of git until it is listed here.
/*

# Repository documents and release metadata
!/.gitignore
!/.github/
!/.release-please-manifest.json
!/AGENTS.md
!/CHANGELOG.md
!/LICENSE
!/README.md
!/release-please-config.json

# Gradle build and wrapper
!/gradle/
!/gradle.properties
!/gradlew
!/gradlew.bat
!/settings.gradle.kts

# The mapping documents and conformance cases the monorepo's sync workflow writes
!/ix-mapper-ts/

# The library module: its build script, hardening records and sources, but none of
# what a build or a fuzz run leaves beside them (build/, out/, .pitest-history/,
# Jazzer crash files)
!/ix-proxy/
/ix-proxy/*
!/ix-proxy/build.gradle.kts
!/ix-proxy/config/
!/ix-proxy/src/

# Never tracked, wherever it turns up inside an unblocked directory (*.tmp covers the
# hardening plugin's *.csv.tmp baseline-write temp)
build/
out/
.gradle/
.kotlin/
.idea/
*.iml
.DS_Store
*.tmp
*.swp
*.bak
*~
